<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget provider info (v2.6). The 30-minute update
     period is the platform minimum for widget updates, which is the
     sensible cadence for a glanceable card that also refreshes when
     the app itself runs. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_argus"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
